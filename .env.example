# Copy this file to .env (which is git-ignored) and fill in your key. Never commit a real key.
# Get a key from the Anthropic Console. The AI coach switches on when ANTHROPIC_API_KEY is set.
ANTHROPIC_API_KEY=

# Optional. Default model is claude-opus-5; claude-sonnet-5 is faster and about 60% cheaper.
# INTERVIEW_TRAINER_MODEL=claude-sonnet-5
# Optional. low | medium | high (default medium). Lower is faster and cheaper.
# INTERVIEW_TRAINER_EFFORT=medium
# Optional usage caps (protect your bill if you deploy this publicly).
# AI_CALLS_PER_IP_PER_HOUR=60
# AI_CALLS_PER_HOUR_TOTAL=600
